{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "API request rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"SprintForge\"}[5m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "5xx error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"SprintForge\",status=~\"5..\"}[5m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "JVM heap used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{application=\"SprintForge\",area=\"heap\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP latency (p95)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"SprintForge\"}[5m])))", "legendFormat": "{{uri}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Sprint domain events",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(sprintforge_sprints_created_total[5m])", "legendFormat": "created", "refId": "A"},
        {"expr": "rate(sprintforge_sprints_status_changed_total[5m])", "legendFormat": "status changed", "refId": "B"}
      ],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 18}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["sprintforge", "spring-boot"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "SprintForge API Overview",
  "uid": "sprintforge-overview",
  "version": 1
}
